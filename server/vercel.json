{
  "version": 2,
  "functions": {
    "server/api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server/api/index.js" },
    { "source": "/", "destination": "/server/portal.html" },
    { "source": "/:path*", "destination": "/server/:path*" }
  ]
}